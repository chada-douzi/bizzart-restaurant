# ============================================================================
# BIZZ'ART MONASTIR - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# 
# 🔴 CRITICAL: DO NOT COMMIT THIS FILE WITH REAL VALUES TO GIT
# 
# Copy this file to .env.production and fill with production values
# Then configure these on your deployment platform (Heroku, Railway, etc.)
# ============================================================================

# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ──────────────────────────────────────────────────────────────
# 🔴 PRODUCTION MongoDB URI
# Options:
# - MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/bizzart
# - Self-hosted: mongodb://host:27017/bizzart
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/bizzart

# ─── JWT Authentication ────────────────────────────────────────────────────
# 🔴 CRITICAL: Generate a strong secret with: openssl rand -base64 64
# NEVER use the default value from .env
JWT_SECRET=GENERATE_STRONG_SECRET_HERE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=4h

# ─── Cloudinary (Already configured) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=gmpztbom
CLOUDINARY_API_KEY=435256423488726
CLOUDINARY_API_SECRET=<set-in-environment>

# ─── Email Configuration ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=bizzart.monastir@gmail.com
EMAIL_PASSWORD=<set-in-environment>
EMAIL_FROM=BIZZ'ART Monastir <bizzart.monastir@gmail.com>

# ─── Frontend URL ──────────────────────────────────────────────────────────
# 🟡 REQUIRED: Update with your production domain
FRONTEND_URL=https://your-production-domain.com

# ─── CORS Configuration ────────────────────────────────────────────────────
# 🟡 REQUIRED: Add your production domain(s)
# Separate multiple domains with commas
ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Admin Credentials ─────────────────────────────────────────────────────
# Used for initial admin creation (seed script)
ADMIN_EMAIL=admin@bizzart.tn
ADMIN_PASSWORD=***REMOVED***

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# 
# ✅ Before deploying to production:
# 
# 1. 🔴 CRITICAL: Generate JWT_SECRET
#    Command: openssl rand -base64 64
#    Replace: GENERATE_STRONG_SECRET_HERE_WITH_OPENSSL_RAND_BASE64_64
# 
# 2. 🟡 REQUIRED: Update FRONTEND_URL
#    Replace: https://your-production-domain.com
# 
# 3. 🟡 REQUIRED: Update ALLOWED_ORIGINS
#    Replace: https://your-production-domain.com
# 
# 4. 🟢 RECOMMENDED: Update MONGODB_URI to production database
#    If using MongoDB Atlas, create production cluster
# 
# 5. 🟢 RECOMMENDED: Update ADMIN_PASSWORD
#    Use a strong password for production
# 
# 6. 🔒 SECURITY: Never commit .env.production to Git
#    File is already in .gitignore
# 
# ============================================================================
# PLATFORM-SPECIFIC INSTRUCTIONS
# ============================================================================
# 
# Heroku:
# -------
# heroku config:set NODE_ENV=production
# heroku config:set JWT_SECRET=<your_secret>
# heroku config:set MONGODB_URI=<your_uri>
# heroku config:set FRONTEND_URL=<your_url>
# heroku config:set ALLOWED_ORIGINS=<your_origins>
# 
# Railway:
# --------
# Add variables in Railway dashboard > Variables tab
# 
# Render:
# -------
# Add variables in Render dashboard > Environment section
# 
# VPS (PM2):
# ----------
# 1. Create .env.production with real values
# 2. pm2 start dist/server.js --name bizzart-backend --env production
# 
# ============================================================================
